# npm 7 and later enforce peer dependency ranges strictly. This project carries
# a Velzon template whose peers have gone stale, and two of them conflict:
#
#   echarts-for-react@3.0.2 peers on echarts ^3 || ^4 || ^5, but the project
#   depends on echarts ^6. That is a hard ERESOLVE error and it stops
#   `npm install` dead.
#
#   eslint-config-react-app wants eslint ^8, the project has eslint ^9. That
#   one only warns, but it warns loudly enough to bury the real error above it.
#
# Both have been present since the initial commit, so a plain `npm install` has
# never worked on this repository. Setting the flag here rather than leaving it
# as folklore means a fresh clone installs with `npm install`, and nobody has to
# already know the incantation - or discover they need it partway through a
# deployment.
#
# Deliberately not --force. That tells npm to write a tree it knows is broken.
# --legacy-peer-deps restores npm 6 behaviour, where peer ranges are advisory
# and the packages themselves are installed exactly as the lockfile says.
#
# The underlying conflict is worth fixing separately: nothing in src/ imports
# echarts or echarts-for-react. The only reference anywhere is a local
# stylesheet, src/assets/scss/plugins/_echarts.scss, which is self-contained and
# does not need either package. Removing both dependencies would remove the
# reason this file has to exist.
legacy-peer-deps=true
