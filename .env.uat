# UAT configuration.
#
# Loaded by:
#   npm run build:uat    env-cmd -f .env.uat -- react-scripts build
#   npm run serve:uat    build:uat, then `serve -s build -l 3000`
#
# Create React App cannot read this file on its own. react-scripts only loads
# .env, .env.local and the .env.<NODE_ENV> variants, and it forces NODE_ENV to
# development, production or test - a custom name is ignored silently. env-cmd
# is what loads it, which is why `npm run build` will NOT pick this up and
# `npm run build:uat` will.
#
# Keep this file COMPLETE rather than a partial override. CRA still loads
# .env.production during a UAT build, and any variable missing here falls
# through to it - including REACT_APP_API_BASE_URL=https://veeto.com.au/, which
# would point a UAT build at PRODUCTION data without anything appearing wrong.
#
# Nothing secret belongs here. Every REACT_APP_* value is substituted into the
# JavaScript bundle at build time and is readable by anyone who loads the page.

PUBLIC_URL=
REACT_APP_API_URL="https://api-node.themesbrand.website"

REACT_APP_DEFAULTAUTH=fake
GENERATE_SOURCEMAP=false

# Absolute, and deliberately so.
#
# `serve -s build` is a static file server with no proxy. A relative base URL
# would send /api/... to serve itself, and the -s flag makes it answer every
# unknown path with index.html - so API calls would come back as HTML rather
# than failing cleanly, which is a miserable thing to debug.
#
# If you are building for the UAT web server instead, and it proxies /api to the
# backend the way production does, set both of these to the relative form below
# so the app calls whatever origin served it:
#
#   REACT_APP_API_BASE_URL=
#   REACT_APP_XERO_APP_CONNECTION_URL=/api/xero/connection
#
# That form is preferable where it works: one bundle runs on any host, and an
# HTTPS page cannot produce an HTTP request, so mixed-content and loopback
# blocks become structurally impossible.
REACT_APP_API_BASE_URL=https://uat.edgelegal.co
REACT_APP_XERO_APP_CONNECTION_URL=https://uat.edgelegal.co/api/xero/connection

# Printed to the console by src/index.js on boot, so it is obvious at a glance
# which environment's bundle is loaded.
REACT_APP_MODE=uat
